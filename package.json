{
  "name": "my-dashboard",
  "version": "0.1.0",
  "description": "MyDashboard - Local-first personal productivity workspace for macOS",
  "main": "./out/main/index.js",
  "author": "Dorck",
  "license": "Apache-2.0",
    "scripts": {
    "dev": "electron-vite dev",
    "dev:detached": "bash scripts/dev-detached.sh",
    "dev:stop": "bash scripts/dev-detached.sh --stop",
    "dev:launchd": "bash scripts/dev-launchd.sh",
    "dev:launchd:stop": "bash scripts/dev-launchd.sh stop",
    "design:generate": "node scripts/design-v2-check.cjs",
    "design:check": "node scripts/design-v2-check.cjs",
    "design:preview": "pnpm --dir docs/design-system/v2 dev",
    "design:build": "pnpm --dir docs/design-system/v2 build",
    "design:verify": "pnpm --dir docs/design-system/v2 verify",
    "design:legacy:generate": "node scripts/design-system.cjs",
    "design:legacy:check": "node scripts/design-system.cjs --check",
    "design:legacy:preview": "node scripts/serve-design-system.cjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "test:trending": "electron scripts/run-trending-test.cjs",
    "test:voiceover": "electron scripts/run-voiceover-test.cjs",
    "test:voice-runtime": "python3 -B scripts/test-voice-runtime.py",
    "test:video-workflow": "electron scripts/run-video-workflow-test.cjs",
    "test:video-workflow:ui": "pnpm build && electron scripts/test-video-workflow-ui.cjs",
    "test:video-workflow:render": "electron scripts/smoke-video-workflow.cjs",
    "test:projects": "electron scripts/run-project-focus-test.cjs",
    "test:activity": "electron scripts/run-activity-test.cjs",
    "test:dashboard-overview": "electron scripts/run-dashboard-overview-test.cjs",
    "test:search": "electron scripts/run-unified-search-test.cjs",
    "test:backup": "electron scripts/run-backup-test.cjs",
    "test:provider-health": "electron scripts/run-provider-health-test.cjs",
    "test:research-materials": "electron scripts/run-research-materials-test.cjs",
    "test:research-assistant": "electron scripts/run-research-assistant-test.cjs",
    "test:content-variants": "electron scripts/run-content-variants-test.cjs",
    "test:focus-sessions": "electron scripts/run-focus-sessions-test.cjs",
    "test:ai-action-planner": "electron scripts/run-ai-action-planner-test.cjs",
    "test:notification-navigation": "electron scripts/run-notification-navigation-test.cjs",
    "test:notification-center": "electron scripts/run-notification-center-test.cjs",
    "test:project-progress": "electron scripts/run-project-progress-test.cjs",
    "test:codex-usage": "electron scripts/run-codex-usage-test.cjs",
    "test:chatgpt-usage-refresh": "node scripts/run-chatgpt-usage-refresh-test.cjs",
    "test:codex-session-usage": "node scripts/run-codex-session-usage-test.cjs",
    "test:reset-radar": "tsx scripts/test-reset-radar.ts",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@tanstack/react-virtual": "^3.13.26",
    "@tiptap/extension-code-block-lowlight": "^3.23.6",
    "@tiptap/extension-highlight": "^3.23.6",
    "@tiptap/extension-image": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-table": "^3.23.6",
    "@tiptap/extension-table-cell": "^3.23.6",
    "@tiptap/extension-table-header": "^3.23.6",
    "@tiptap/extension-table-row": "^3.23.6",
    "@tiptap/extension-task-item": "^3.23.6",
    "@tiptap/extension-task-list": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "better-sqlite3": "^11.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lowlight": "^3.3.0",
    "msedge-tts": "2.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "rss-parser": "^3.13.0",
    "tailwind-merge": "^2.6.0",
    "tiptap-markdown": "^0.9.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.16.0",
    "@typescript-eslint/parser": "^8.16.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^6.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
